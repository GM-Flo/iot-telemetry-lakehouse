{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gtk.telemetry.v1",
  "title": "GeoTrak telemetry v1",
  "description": "Nested objects, metric units, timestamps as 'YYYY-MM-DD HH:MM:SS' with no zone (UTC by agreement). One reading per message.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "device",
    "asset",
    "driver",
    "time",
    "sent",
    "position",
    "engine",
    "electrical",
    "events",
    "dtc"
  ],
  "properties": {
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fw"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^GTK-[0-9A-F]{6}$"
        },
        "fw": {
          "type": "string"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vin",
        "customer"
      ],
      "properties": {
        "vin": {
          "type": "string",
          "pattern": "^[A-HJ-NPR-Z0-9]{17}$"
        },
        "customer": {
          "type": "string",
          "pattern": "^C[0-9]{3}$"
        }
      }
    },
    "driver": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "fob"
      ],
      "properties": {
        "fob": {
          "type": "string",
          "pattern": "^FOB-[0-9A-F]{8}$"
        }
      },
      "description": "Logged-in driver; null when the engine is off"
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$"
    },
    "sent": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$"
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat",
        "lon",
        "bearing",
        "speed_kmh"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "bearing": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "speed_kmh": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "on",
        "rpm",
        "coolant_temp_c",
        "coolant_kpa",
        "oil_kpa",
        "fuel_pct",
        "odo_km"
      ],
      "properties": {
        "on": {
          "type": "boolean"
        },
        "rpm": {
          "type": "integer",
          "minimum": 0
        },
        "coolant_temp_c": {
          "type": "number"
        },
        "coolant_kpa": {
          "type": "number"
        },
        "oil_kpa": {
          "type": "number"
        },
        "fuel_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "odo_km": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "electrical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "battery_v"
      ],
      "properties": {
        "battery_v": {
          "type": "number"
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harsh_brake",
        "harsh_accel"
      ],
      "properties": {
        "harsh_brake": {
          "type": "integer",
          "minimum": 0,
          "description": "Harsh braking events since the previous reading"
        },
        "harsh_accel": {
          "type": "integer",
          "minimum": 0,
          "description": "Harsh acceleration events since the previous reading"
        }
      }
    },
    "dtc": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[PBCU][0-9]{4}$"
    }
  }
}