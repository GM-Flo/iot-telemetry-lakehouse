{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "envelope.v1",
  "title": "Ingestion gateway envelope v1",
  "description": "Wrapper the ingestion gateway puts around every vendor payload before it reaches Event Hubs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["envelope_version", "message_id", "vendor_id", "contract", "received_at", "payload"],
  "properties": {
    "envelope_version": {"const": "1.0"},
    "message_id": {"type": "string", "format": "uuid"},
    "vendor_id": {"enum": ["tmx", "fpl", "gtk", "ats"]},
    "contract": {"type": "string", "pattern": "^(tmx|fpl|gtk|ats)\\.telemetry\\.v[0-9]+$"},
    "received_at": {"type": "string", "format": "date-time"},
    "payload": {"type": "object"}
  }
}