{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ats.telemetry.v1",
  "title": "AutoSense telemetry v1",
  "description": "Batched: one message carries 1-10 readings from a single device. Terse keys, metric units, epoch-second timestamps with millisecond fraction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dev",
    "vin",
    "acct",
    "fw",
    "sent",
    "readings"
  ],
  "properties": {
    "dev": {
      "type": "string",
      "pattern": "^ATS-[0-9A-F]{6}$"
    },
    "vin": {
      "type": "string",
      "pattern": "^[A-HJ-NPR-Z0-9]{17}$"
    },
    "acct": {
      "type": "string",
      "pattern": "^C[0-9]{3}$"
    },
    "fw": {
      "type": "string"
    },
    "sent": {
      "type": "number",
      "description": "Transmission time of the batch, epoch seconds UTC"
    },
    "readings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "t",
          "fob",
          "ign",
          "spd",
          "rpm",
          "tmp",
          "clp",
          "oil",
          "bat",
          "ful",
          "odo",
          "lat",
          "lon",
          "hdg",
          "dtc",
          "hb",
          "ha"
        ],
        "properties": {
          "t": {
            "type": "number",
            "description": "Event time, epoch seconds UTC"
          },
          "fob": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^FOB-[0-9A-F]{8}$",
            "description": "Driver key fob; null when no driver is logged in (engine off)"
          },
          "ign": {
            "enum": [
              0,
              1
            ]
          },
          "spd": {
            "type": "number",
            "minimum": 0,
            "description": "km/h"
          },
          "rpm": {
            "type": "integer",
            "minimum": 0
          },
          "tmp": {
            "type": "number",
            "description": "engine temperature, degrees C"
          },
          "clp": {
            "type": "number",
            "description": "coolant pressure, kPa"
          },
          "oil": {
            "type": "number",
            "description": "oil pressure, kPa"
          },
          "bat": {
            "type": "number",
            "description": "battery, volts"
          },
          "ful": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "odo": {
            "type": "number",
            "minimum": 0,
            "description": "km"
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "hdg": {
            "type": "number",
            "minimum": 0,
            "maximum": 360
          },
          "dtc": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[PBCU][0-9]{4}$"
          },
          "hb": {
            "type": "integer",
            "minimum": 0,
            "description": "harsh braking events since the previous reading"
          },
          "ha": {
            "type": "integer",
            "minimum": 0,
            "description": "harsh acceleration events since the previous reading"
          }
        }
      }
    }
  }
}